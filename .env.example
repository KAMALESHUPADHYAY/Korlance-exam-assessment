# PostgreSQL connection string (e.g., Neon serverless PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Session signing secret (use a long random string in production)
SESSION_SECRET="replace-with-long-random-secret-string"

# Gmail SMTP credentials (use a Gmail App Password)
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-gmail-app-password"

# Admin Dashboard credentials & notification email
ADMIN_USER="admin"
ADMIN_PASSWORD="replace-with-strong-admin-password"
ADMIN_EMAIL="admin@korlance.com"

# Proctoring & exam configuration
MAX_ALLOWED_VIOLATIONS="2"
EXAM_DURATION_MINUTES="30"
MAX_ATTEMPTS_PER_EMAIL="1"

# Set to "true" to show score on student submission screen
NEXT_PUBLIC_SHOW_SCORE_ON_SUBMIT="false"
