generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Question {
  id           String   @id @default(cuid())
  domain       String
  difficulty   String   @default("Medium")
  prompt       String
  optionsJson  String
  correctIndex Int
  explanation  String   @default("")
  createdAt    DateTime @default(now())
}

model Student {
  id             String      @id @default(cuid())
  fullName       String
  email          String      @unique
  collegeName    String
  domain         String      @default("Data Science")
  status         String      @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | SUBMITTED | AUTO_SUBMITTED
  agreedToRules  Boolean     @default(false)
  questionOrder  String?     // JSON array of Question IDs
  optionOrders   String?     // JSON record: { [questionId]: number[] }
  answers        String?     // JSON record: { [questionId]: number } (original option index)
  markedReview   String?     // JSON array of Question IDs
  startedAt      DateTime?
  expiresAt      DateTime?
  submittedAt    DateTime?
  score          Int?
  totalQuestions Int         @default(30)
  violationCount Int         @default(0)
  emailSent      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  violations     Violation[]
  snapshots      Snapshot[]
}

model Violation {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type         String   // TAB_SWITCH | WINDOW_BLUR | FULLSCREEN_EXIT | CAMERA_OFF | COPY_PASTE | DEVTOOLS_ATTEMPT | NO_FACE | MULTIPLE_FACES | LOOKING_AWAY
  details      String?
  snapshotPath String?
  screenshot   String?  // Fallback preview or inline thumbnail
  createdAt    DateTime @default(now())
}

model Snapshot {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  filePath      String
  url           String
  reason        String   @default("PERIODIC") // PERIODIC | VIOLATION
  violationType String?
  imageData     String?  // Base64 fallback for read-only/ephemeral serverless filesystems
  createdAt     DateTime @default(now())
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
